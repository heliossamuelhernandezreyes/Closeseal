{
  "protocol_version": 1,
  "editor": "Close Seal Map Forge",
  "map_directory": "maps",
  "physical_directory": "maps/physical",
  "adapter_command": ["python3", "tools/map_forge_adapter.py"],
  "adapter_timeout_seconds": 240,
  "arcont_tool_environment": "ARCONT_ROOT",
