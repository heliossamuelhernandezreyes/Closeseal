{
  "version": 1,
  "id": "nexo_sector_lighting",
  "description": "Native local reflection volumes for Sector 07, kept separate from the canonical map.",
  "steps": [
    {
      "op": "new",
      "id": "presentation",
      "class": "Node3D",
      "name": "SectorPresentation"
    },
    {
      "op": "new",
      "id": "courtyard_probe",
      "class": "ReflectionProbe",
      "name": "CourtyardReflection",
      "parent": "presentation",
      "properties": {
        "position": {
          "$type": "Vector3",
          "value": [
            0,
            4,
            84
          ]
        },
        "size": {
          "$type": "Vector3",
          "value": [
            34,
            10,
            48
          ]
        },
        "intensity": 0.55,
        "box_projection": true,
        "max_distance": 50.0
      }
    },
    {
      "op": "new",
      "id": "workshop_probe",
      "class": "ReflectionProbe",
      "name": "WorkshopReflection",
      "parent": "presentation",
      "properties": {
        "position": {
          "$type": "Vector3",
          "value": [
            24,
            3.2,
            80
          ]
        },
        "size": {
          "$type": "Vector3",
          "value": [
            22,
            7.2,
            28
          ]
        },
        "intensity": 0.75,
        "box_projection": true,
        "max_distance": 35.0
      }
    },
    {
      "op": "attach",
      "target": "presentation"
    },
    {
      "op": "save",
      "target": "presentation",
      "path": "scenes/nexo_sector_lighting.tscn"
    }
  ]
}
