[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="Shader_signal"]
code = "shader_type spatial;\nrender_mode unshaded;\nvoid fragment() {\nfloat stripe = step(0.8, fract(UV.y * 12.0));\nALBEDO = mix(vec3(0.05, 0.6, 0.8), vec3(0.7, 1.0, 1.0), stripe);\nEMISSION = ALBEDO * 0.4;\n}"

[resource]
shader = SubResource("Shader_signal")
